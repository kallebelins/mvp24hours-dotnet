{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Mvp24Hours": "Debug"
    }
  },
  "AllowedHosts": "*",
  "CronJobs": {
    "HeartbeatJob": {
      "CronExpression": "* * * * *"
    },
    "CleanupJob": {
      "CronExpression": "*/5 * * * *"
    }
  }
}
