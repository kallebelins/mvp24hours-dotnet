{
  "realm": "mvp24hours-test",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "user" },
      { "name": "admin" }
    ]
  },
  "groups": [
    {
      "name": "test-group",
      "realmRoles": [ "user" ]
    }
  ],
  "clients": [
    {
      "clientId": "mvp24hours-test-client",
      "name": "Mvp24Hours integration tests",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "mvp24hours-test-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "authorizationServicesEnabled": true,
      "publicClient": false,
      "redirectUris": [ "http://localhost/*" ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "mvp24hours-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "mvp24hours-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ],
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "resources": [
          {
            "name": "orders",
            "displayName": "Orders",
            "ownerManagedAccess": false,
            "scopes": [
              { "name": "read" },
              { "name": "write" }
            ]
          }
        ],
        "policies": [
          {
            "name": "admin-role-policy",
            "description": "Only realm administrators",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"admin\",\"required\":true}]"
            }
          },
          {
            "name": "orders-read-permission",
            "description": "Administrators can read orders",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"orders\"]",
              "scopes": "[\"read\"]",
              "applyPolicies": "[\"admin-role-policy\"]"
            }
          }
        ],
        "scopes": [
          { "name": "read" },
          { "name": "write" }
        ]
      }
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "test-user",
      "email": "test-user@mvp24hours.dev",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "test-password",
          "temporary": false
        }
      ],
      "realmRoles": [ "user" ],
      "groups": [ "/test-group" ]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "test-admin",
      "email": "test-admin@mvp24hours.dev",
      "firstName": "Test",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "test-password",
          "temporary": false
        }
      ],
      "realmRoles": [ "user", "admin" ]
    },
    {
      "username": "service-account-mvp24hours-test-client",
      "enabled": true,
      "serviceAccountClientId": "mvp24hours-test-client",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "manage-realm",
          "view-realm"
        ]
      }
    }
  ]
}
