<Project>
  <!--
    Inherit Central Package Management and shared third-party versions from src/.
    Sample-only packages (HealthChecks, NLog, Dapper, tooling) are appended below.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\src\Directory.Packages.props" />

  <ItemGroup>
    <!-- Health checks — MongoDb 9.x required for MongoDB.Driver 3.x (aligned with src/). Other HC packages remain on 8.x until Phase 6.1. -->
    <PackageVersion Include="AspNetCore.HealthChecks.MongoDb" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Rabbitmq" Version="8.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="8.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="8.0.0" />

    <!-- Logging demos (samples only; library prefers ILogger + OpenTelemetry). -->
    <PackageVersion Include="NLog" Version="5.2.8" />
    <PackageVersion Include="NLog.Config" Version="4.7.15" />
    <PackageVersion Include="NLog.Web.AspNetCore" Version="5.3.8" />

    <!-- Dapper hybrid samples. -->
    <PackageVersion Include="Dapper" Version="2.1.28" />
    <PackageVersion Include="Dapper.SqlBuilder" Version="2.0.78" />

    <!-- Sample tooling not centralized under src/. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.9" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.6" />

    <!-- Aspire hosting resource packages (AppHost project only). Requires: dotnet workload install aspire -->
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.4.6" />
  </ItemGroup>

  <!-- Published-package fallback for standalone sample consumption. -->
  <ItemGroup Condition="'$(Mvp24HoursUseProjectReferences)' != 'true'">
    <PackageVersion Include="Mvp24Hours.Application" Version="$(Mvp24HoursPackageVersion)" />
    <PackageVersion Include="Mvp24Hours.Core" Version="$(Mvp24HoursPackageVersion)" />
    <PackageVersion Include="Mvp24Hours.Infrastructure.Caching.Redis" Version="$(Mvp24HoursPackageVersion)" />
    <PackageVersion Include="Mvp24Hours.Infrastructure.Cqrs" Version="$(Mvp24HoursPackageVersion)" />
    <PackageVersion Include="Mvp24Hours.Infrastructure.Data.EFCore" Version="$(Mvp24HoursPackageVersion)" />
    <PackageVersion Include="Mvp24Hours.Infrastructure.Data.MongoDb" Version="$(Mvp24HoursPackageVersion)" />
    <PackageVersion Include="Mvp24Hours.Infrastructure.Pipe" Version="$(Mvp24HoursPackageVersion)" />
    <PackageVersion Include="Mvp24Hours.Infrastructure.RabbitMQ" Version="$(Mvp24HoursPackageVersion)" />
    <PackageVersion Include="Mvp24Hours.WebAPI" Version="$(Mvp24HoursPackageVersion)" />
  </ItemGroup>
</Project>
