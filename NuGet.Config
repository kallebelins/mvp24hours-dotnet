<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repo-scoped sources for Central Package Management (NU1507).
    Isolates this solution from machine-level feeds (e.g. unreachable private feeds → NU1900).
    All current PackageReference IDs resolve from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
