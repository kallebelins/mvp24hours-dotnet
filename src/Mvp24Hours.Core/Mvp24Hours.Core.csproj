<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Authors>Kallebe Lins</Authors>
		<Description>Series architectures for fast product construction.</Description>
		<Copyright></Copyright>
		<PackageProjectUrl>https://mvp24hours.dev</PackageProjectUrl>
		<Company>Kallebe Lins</Company>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Version>9.1.21</Version>
		<AssemblyVersion>9.1.2.1</AssemblyVersion>
		<FileVersion>9.1.2.1</FileVersion>
		<RepositoryUrl>https://github.com/kallebelins/mvp24hours-dotnet</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<!-- FrameworkReference for ASP.NET Core APIs including IMvcBuilder.AddJsonOptions -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- Microsoft.Extensions.* / System.Threading.RateLimiting: provided by FrameworkReference Microsoft.AspNetCore.App (NU1510). -->
		<PackageReference Include="AutoMapper" />
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="FluentValidation" />
		<PackageReference Include="OpenTelemetry" />
	</ItemGroup>

	<ItemGroup>
		<SonarQubeSetting Include="sonar.stylecop.projectFilePath">
			<Value>$(MSBuildProjectFullPath)</Value>
		</SonarQubeSetting>
	</ItemGroup>
</Project>
