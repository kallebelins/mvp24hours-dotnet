<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>Mvp24Hours.Infrastructure</PackageId>
		<Authors>Kallebe Lins</Authors>
		<Description>Cross-cutting infrastructure for email, messaging, storage, resilient HTTP, distributed locks, secrets, and background jobs.</Description>
		<Copyright></Copyright>
		<PackageProjectUrl>https://kallebelins.github.io/mvp24hours-dotnet</PackageProjectUrl>
		<Company>Kallebe Lins</Company>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<PackageTags>infrastructure;email;sms;file-storage;http-client;resilience;distributed-lock;secrets;health-checks;mvp24hours</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Version>10.8.0</Version>
		<AssemblyVersion>10.8.0.1</AssemblyVersion>
		<FileVersion>10.8.0.1</FileVersion>
		<RepositoryUrl>https://github.com/kallebelins/mvp24hours-dotnet</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\docs\_media\icon.png" Pack="true" PackagePath="\" Link="icon.png" />
	</ItemGroup>

	<ItemGroup>
		<!-- Microsoft.Extensions.* below AspNetCore.App: omitted (NU1510); provided by FrameworkReference. -->
		<PackageReference Include="AutoMapper" />
		<PackageReference Include="MessagePack" />
		<PackageReference Include="Microsoft.Extensions.Http.Polly" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" />
		<PackageReference Include="Polly" />
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="Scriban" />
		<PackageReference Include="StackExchange.Redis" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Npgsql" />
		<PackageReference Include="Azure.Security.KeyVault.Secrets" />
		<PackageReference Include="Azure.Identity" />
		<PackageReference Include="AWSSDK.SecretsManager" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Mvp24Hours.Core\Mvp24Hours.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<SonarQubeSetting Include="sonar.stylecop.projectFilePath">
			<Value>$(MSBuildProjectFullPath)</Value>
		</SonarQubeSetting>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mvp24Hours.Infrastructure.Test" />
	</ItemGroup>

</Project>
