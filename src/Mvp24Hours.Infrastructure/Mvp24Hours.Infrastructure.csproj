<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Authors>Kallebe Lins</Authors>
		<Description>Series architectures for fast product construction.</Description>
		<Copyright></Copyright>
		<PackageProjectUrl>https://mvp24hours.dev</PackageProjectUrl>
		<Company>Kallebe Lins</Company>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Version>9.1.21</Version>
		<AssemblyVersion>9.1.2.1</AssemblyVersion>
		<FileVersion>9.1.2.1</FileVersion>
		<RepositoryUrl>https://github.com/kallebelins/mvp24hours-dotnet</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<!-- Microsoft.Extensions.* below AspNetCore.App: omitted (NU1510); provided by FrameworkReference. -->
		<PackageReference Include="AutoMapper" />
		<PackageReference Include="MessagePack" />
		<PackageReference Include="Microsoft.Extensions.Http.Polly" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" />
		<PackageReference Include="Polly" />
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="Scriban" />
		<PackageReference Include="StackExchange.Redis" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Npgsql" />
		<PackageReference Include="System.ServiceModel.Http" />
		<PackageReference Include="Azure.Security.KeyVault.Secrets" />
		<PackageReference Include="Azure.Identity" />
		<PackageReference Include="AWSSDK.SecretsManager" />
		<PackageReference Include="System.ServiceModel.Primitives" />
		<!-- Security pin: ServiceModel.Primitives → Cryptography.Xml 10.0.0 (NU1903 GHSA-37gx / GHSA-w3x6). Version in Directory.Packages.props (10.0.10). NU1510 expected here (AspNetCore.App); required so consumers without the shared framework resolve the patched version. -->
		<PackageReference Include="System.Security.Cryptography.Xml" NoWarn="NU1510" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Mvp24Hours.Core\Mvp24Hours.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<SonarQubeSetting Include="sonar.stylecop.projectFilePath">
			<Value>$(MSBuildProjectFullPath)</Value>
		</SonarQubeSetting>
	</ItemGroup>

</Project>
