<Project>
  <!--
    Shared build defaults for every project under src/.
    Individual .csproj files should only keep justified overrides
    (e.g. ImplicitUsings=disable, temporary TargetFramework).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Scoped quality gate (task 10.3). The CI `code-quality` job builds with
    /p:TreatWarningsAsErrors=true so any NEW warning category fails the build.
    The codes below are the residual warnings accepted in task 10.1 (see
    tasks/phase10-gate-treatwarningsaserrors-net10-v1.md); they stay warnings
    (not errors) until the v2 hygiene pass drives them to zero. Do NOT add new
    codes here without documenting the reason.
      Nullable (NRT):      CS8600 CS8602 CS8603 CS8604 CS8618 CS8619 CS8620
                           CS8622 CS8625 CS8629 CS8631 CS8764
      Obsolete API:        CS0618 (4 residuals: MongoDbResiliencyExtensions.cs
                           compat shim + EFCore MvpExecutionStrategy auto-obsolete)
      NuGet (intentional): NU1510 (redundant ref kept for the 7.1 security pin)
    Zeroed in v2 (removed from the list):
      LOGGEN002 (task 4.1 — unique EventIds),
      ASPDEPR006 (task 4.5 — IActionContextAccessor removed),
      SYSLIB0057 (task 4.4 — X509CertificateLoader),
      CS0108 (task 4.6 — removed hidden _logger fields),
      xUnit1031 (task 4.7 — async test converted to await).
  -->
  <PropertyGroup>
    <MvpResidualWarnings>CS8600;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8622;CS8625;CS8629;CS8631;CS8764;CS0618;NU1510</MvpResidualWarnings>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);$(MvpResidualWarnings)</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
