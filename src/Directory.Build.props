<Project>
  <!--
    Shared build defaults for every project under src/.
    Individual .csproj files should only keep justified overrides
    (e.g. ImplicitUsings=disable, temporary TargetFramework).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Strict quality gate (task 7.1 / v2). CI builds with TreatWarningsAsErrors=true.
    All CS86xx / CS0618 / LOGGEN002 / ASPDEPR006 / SYSLIB0057 / CS0108 / xUnit1031
    residuals from the v1/v2 hygiene pass are zero. The only remaining entry is
    NU1510 — intentional: System.Security.Cryptography.Xml is pinned in
    Infrastructure (NoWarn=NU1510 on the PackageReference) so consumers without
    AspNetCore.App resolve the patched version (NU1903 / task 7.1 v1). Do NOT add
    new codes here without documenting the reason.
    CS1572–CS1574 / CS0419 — legacy XML doc cref and param-tag mismatches in
    Infrastructure; excluded until normalized (malformed CS1570 blocks were fixed).
  -->
  <PropertyGroup>
    <MvpResidualWarnings>NU1510;CS1572;CS1573;CS1574;CS0419</MvpResidualWarnings>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);$(MvpResidualWarnings)</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
