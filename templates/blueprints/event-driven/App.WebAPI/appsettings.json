{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Name": "AppEventDriven"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Caching": {
    "Provider": "Hybrid"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "HttpHardening": {
    "RateLimiting": {
      "Enabled": true,
      "PermitLimit": 200,
      "WindowSeconds": 60
    },
    "Idempotency": {
      "Enabled": true,
      "RequireKey": false
    },
    "OutputCache": {
      "Enabled": true,
      "DefaultExpirationSeconds": 60
    }
  },
  "RabbitMQ": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/mvp24hours",
    "Realm": "mvp24hours",
    "ClientId": "app-event-driven-api",
    "Audience": "app-event-driven-api",
    "RequireHttpsMetadata": false,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "Authorization": {
      "PolicyEnforcementMode": "Permissive",
      "UseDecisionEndpoint": false,
      "UseRptEndpoint": false,
      "ResourceServerClientId": "app-event-driven-api"
    },
    "Admin": {
      "AdminBaseUrl": "http://localhost:8080/admin/realms/mvp24hours",
      "Realm": "mvp24hours",
      "ClientId": "app-admin",
      "ClientSecret": "change-me",
      "ServiceAccountEnabled": true
    }
  }
}
