<Project>
  <!-- Shared defaults for every project under templates/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Mvp24HoursSourceRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\src'))</Mvp24HoursSourceRoot>

    <!--
      Use local source projects only when the monorepo source tree is available.
      Copied templates fall back to published NuGet packages automatically.
    -->
    <Mvp24HoursUseProjectReferences Condition="'$(Mvp24HoursUseProjectReferences)' == '' and Exists('$(Mvp24HoursSourceRoot)\Mvp24Hours.Core\Mvp24Hours.Core.csproj')">true</Mvp24HoursUseProjectReferences>
    <Mvp24HoursUseProjectReferences Condition="'$(Mvp24HoursUseProjectReferences)' == ''">false</Mvp24HoursUseProjectReferences>
    <Mvp24HoursPackageVersion Condition="'$(Mvp24HoursPackageVersion)' == ''">10.0.0</Mvp24HoursPackageVersion>
  </PropertyGroup>
</Project>
